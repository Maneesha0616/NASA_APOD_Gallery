@model NasaApodGallery.Models.GalleryViewModel
@{
    ViewData["Title"] = "Cosmic Gallery";
}

<!-- Hero Title -->
<div class="text-center pt-3 pb-2 mb-2">
    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25);">
        <i class="bi bi-stars text-info small"></i>
        <span class="text-info small fw-semibold text-uppercase" style="letter-spacing: 0.06em;">NASA Astronomy Picture of the Day</span>
    </div>
    <h1 class="display-4 fw-bold text-light mb-1 text-glow">
        Astronomy <span class="text-gradient">Gallery</span>
    </h1>
</div>

<!-- ===================================================================
     Clean Sticky Bar: Search & Inline Fetch
     =================================================================== -->
<div class="sticky-control-deck p-3 mb-4">
    <div class="row g-2 align-items-center">
        <!-- Live Search & Sort -->
        <div class="col-lg-5">
            <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-7">
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm glass-input" placeholder="Search title or nebula..." />
                        <button type="submit" class="btn btn-sm btn-outline-info" title="Search">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-5 d-flex gap-1">
                    <select name="sort" class="form-select form-select-sm glass-input" onchange="this.form.submit()">
                        <option value="desc" selected="@(Model.SortOrder == "desc" || string.IsNullOrEmpty(Model.SortOrder))">Newest</option>
                        <option value="asc" selected="@(Model.SortOrder == "asc")">Oldest</option>
                    </select>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SortOrder == "asc")
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-flex align-items-center" title="Reset Search and Sort">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>

        <!-- Inline Date Fetcher -->
        <div class="col-lg-7">
            <form asp-controller="Home" asp-action="Fetch" method="post" class="row g-2 align-items-center justify-content-lg-end">
                @Html.AntiForgeryToken()
                <div class="col-auto">
                    <input asp-for="FetchRequest.StartDate" class="form-control form-control-sm glass-input text-center" style="width: 135px;" type="date" id="fetchStartDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-auto text-secondary small">→</div>
                <div class="col-auto">
                    <input asp-for="FetchRequest.EndDate" class="form-control form-control-sm glass-input text-center" style="width: 135px;" type="date" id="fetchEndDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-neon-cyan px-3">
                        <i class="bi bi-cloud-arrow-down-fill me-1"></i>Fetch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===================================================================
     Astronomy Gallery Grid
     =================================================================== -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="text-light fw-bold mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-grid-3x3-gap-fill text-info"></i> Saved APOD Gallery
    </h5>
    <span class="text-secondary small">
        Showing <strong>@Model.DisplayedCount</strong> of <strong>@Model.TotalSavedCount</strong> saved item(s)
    </span>
</div>

@if (Model.Entries.Count > 0)
{
    <div class="row g-4">
        @foreach (var entry in Model.Entries)
        {
            <partial name="_ApodCard" model="entry" />
        }
    </div>
}
else
{
    <div class="card glass-modal text-center py-5 my-4 border border-secondary border-opacity-25 rounded-4">
        <div class="card-body">
            <i class="bi bi-telescope fs-1 text-info mb-3 d-inline-block"></i>
            <h4 class="text-light mb-2">No Astronomy Pictures Found</h4>
            @if (Model.TotalSavedCount > 0)
            {
                <p class="text-secondary mb-3">
                    No pictures matched your search keyword "<em>@Model.SearchTerm</em>".
                </p>
                <a asp-action="Index" class="btn btn-outline-info btn-sm rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filter
                </a>
            }
            else
            {
                <p class="text-secondary mb-3">Your database currently has no APOD records. Click below to fetch recent astronomy pictures!</p>
                <form asp-controller="Home" asp-action="QuickFetch" method="post" class="d-inline-block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="days" value="7" />
                    <button type="submit" class="btn btn-neon-cyan px-4 py-2">
                        <i class="bi bi-cloud-arrow-down-fill me-1"></i> Fetch Last 7 Days of APOD
                    </button>
                </form>
            }
        </div>
    </div>
}

<!-- Dynamic Preview Modal -->
<div class="modal fade" id="apodModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal text-light">
            <div class="modal-header border-secondary border-opacity-25 p-3">
                <div>
                    <h5 class="modal-title fw-bold text-info" id="modalTitle">APOD Details</h5>
                    <span class="badge bg-secondary text-light small mt-1" id="modalDate"></span>
                    <span class="badge bg-dark border border-secondary text-secondary small mt-1" id="modalCopyright" style="display:none;"></span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="modalMediaContainer" class="mb-3"></div>
                <h6 class="text-secondary fw-semibold text-uppercase small mb-2">Explanation</h6>
                <p id="modalExplanation" class="text-light text-opacity-90 leading-relaxed mb-0" style="max-height: 200px; overflow-y: auto;"></p>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 d-flex justify-content-end gap-2 p-3">
                <a id="modalFullPageLink" href="#" class="btn btn-sm btn-neon-cyan">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Dedicated Page
                </a>
                <button type="button" class="btn btn-sm btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
